#!/bin/bash
# travel — 旅伴  入口
# 用法: travel --city 武汉 --start_time 2026-04-16_12:00 --end_time 2026-04-18_19:00 --cost 500

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LOG_FILE="$SCRIPT_DIR/travel.log"

cd "$SCRIPT_DIR"

# 检查 Python3
if ! command -v python3 &> /dev/null; then
    echo "❌ 需要 Python3，请先安装" | tee -a "$LOG_FILE"
    exit 1
fi

# 检查依赖
if ! python3 -c "import requests" &> /dev/null; then
    echo "📦 安装依赖..." | tee -a "$LOG_FILE"
    pip3 install -q requests
fi

# 执行主程序，并同时输出到终端和日志文件
echo "🚀 启动旅伴 $(date '+%Y-%m-%d %H:%M:%S')" | tee -a "$LOG_FILE"
PYTHONUNBUFFERED=1 python3 -u main.py "$@" 2>&1 | tee -a "$LOG_FILE"
